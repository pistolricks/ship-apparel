{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-zip": "*",
        "anaseqal/nova-import": "^0.0.6",
        "bissolli/nova-phone-field": "^0.0.4",
        "calebporzio/sushi": "^2.5",
        "chaseconey/nova-external-image": "^1.0",
        "dedmytro/laravel-cloudflare-images": "^0.2.1",
        "digital-creative/custom-relationship-field": "^1.1",
        "digital-creative/nova-dashboard": "^1.1",
        "dniccum/phone-number": "^2.3",
        "ebess/advanced-nova-media-library": "^4.4",
        "emiliogrv/nova-batch-load": "^1.2",
        "guzzlehttp/guzzle": "^7.2",
        "inspheric/nova-email-field": "^2.0",
        "laravel/cashier": "^15.0",
        "laravel/framework": "^11.0",
        "laravel/horizon": "*",
        "laravel/nova": "4.35.2",
        "laravel/telescope": "^5.0",
        "laravel/tinker": "^2.8",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-ftp": "^3.29",
        "league/flysystem-path-prefixing": "^3.28",
        "league/flysystem-sftp-v3": "^3.29",
        "league/flysystem-ziparchive": "^3.29",
        "livewire/livewire": "^3.0",
        "lorisleiva/laravel-actions": "^2.9",
        "maatwebsite/excel": "^3.1",
        "maatwebsite/laravel-nova-excel": "^1.3",
        "oriondevelops/nova-greeter": "^0.0.3",
        "pdewit/nova-external-url": "^1.0",
        "psr/simple-cache": "^2.0",
        "r64/nova-image-cropper": "^1.1",
        "saloonphp/laravel-plugin": "^3.0",
        "saloonphp/saloon": "^3.0",
        "saloonphp/xml-wrangler": "^1.4",
        "sanmar/inventory": "@dev",
        "simonhamp/laravel-nova-csv-import": "^0.7.2",
        "spatie/laravel-data": "^4.13",
        "spatie/laravel-medialibrary": "^11.12",
        "spatie/laravel-queueable-action": "^2.16",
        "spatie/laravel-sluggable": "^3.7",
        "spatie/laravel-tags": "^4.10",
        "spatie/nova-tags-field": "^4.1",
        "spatie/simple-excel": "^3.7",
        "stancl/tenancy": "^3.7",
        "wdelfuego/nova-calendar": "^2.1",
        "zanysoft/laravel-zip": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        },
        {
            "type": "path",
            "url": "./nova-components/Inventory"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    }
}
